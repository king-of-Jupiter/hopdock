{
  "name": "hopdock-desktop",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p .",
    "build:termius-reader": "python ../../tools/build-termius-reader.py",
    "dist": "npm run build:termius-reader && npm run build && electron-builder --publish never",
    "dist:publish": "npm run build:termius-reader && npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "sshpk": "^1.18.0",
    "ws": "8.22.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "app.hopdock",
    "productName": "Hopdock",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/termius-reader",
        "to": "termius-reader"
      },
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/hopdock-icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/hopdock-icon.png",
      "darkModeSupport": true
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "build/hopdock-icon.png",
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 360,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/hopdock-icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "king-of-Jupiter",
      "repo": "hopdock",
      "releaseType": "release"
    }
  }
}
